---
import Seats from '../Seats.astro';
import { site } from '../../site.config';

const { totalSeats, taken } = site.founding;
---

<section class="seats-teaser" aria-labelledby="seats-title">
  <div class="wrap inner">
    <div class="copy">
      <p class="label">[06] Founding seats</p>
      <h2 id="seats-title" class="display display-l" data-boring="Affordable Pricing Plans">Three seats. Founder pricing.</h2>
      <p class="lede">
        We're new. No portfolio, no case studies, no borrowed logos. So we're taking {totalSeats} founding clients at founder
        pricing, in exchange for a case study and honest feedback.
      </p>
      <p class="label count"><span class="mark">{taken.length} of {totalSeats} taken.</span> Pricing? Ask us.</p>
      <a class="btn" href="/founding" data-cursor="sit">See the deal <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <Seats />
  </div>
</section>

<style>
  .seats-teaser { border-bottom: var(--rule); }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    padding-block: var(--section);
  }
  .copy { display: grid; gap: 1.25rem; justify-items: start; }
  .copy h2 { max-width: 11ch; }
  @media (min-width: 1000px) {
    .inner { grid-template-columns: 1fr 1.1fr; align-items: center; }
  }
</style>
