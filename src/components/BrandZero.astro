---
/**
 * Brand zero: our own company, Lumin Art. Presented as ours, with the relationship stated plainly,
 * so it reads as proof we practise what we sell, not as a borrowed client logo.
 */
import { site } from '../site.config';

interface Props {
  /** Section label, e.g. "[07] Brand zero". */
  label?: string;
  compact?: boolean;
}
const { label = 'Brand zero', compact = false } = Astro.props;
const b = site.brandZero;
const insta = `https://instagram.com/${b.instagram}`;
---

<section class:list={['bz', 'on-ink', { compact }]} aria-labelledby="bz-title">
  <div class="wrap inner">
    <div class="copy">
      <p class="label lime">{label}</p>
      <h2 id="bz-title" class="display display-l" data-boring="Our Valued Clients">We test on ourselves first.</h2>
      <p class="lede">
        {b.name} is our own company: {b.what.toLowerCase()} for {b.forWho}, from {b.where}. Every idea we pitch you gets
        tried on {b.name} first, with our own money on the line.
      </p>
      <p class="label muted">Full disclosure: same owners. It holds founding seat 1, and we say so.</p>
    </div>

    <a class="card" href={insta} rel="noopener" data-cursor="look">
      <span class="label tag">Already running</span>
      <span class="display name">{b.name}</span>
      <span class="what">{b.what}.</span>
      <span class="label meta">{b.where}</span>
      <span class="label go">@{b.instagram} on Instagram <span aria-hidden="true">→</span></span>
    </a>
  </div>
</section>

<style>
  .bz { border-bottom: var(--rule); }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-block: var(--section);
  }
  .compact .inner { padding-block: clamp(3rem, 6vw, 5rem); }
  .lime { color: var(--lime); }
  .copy { display: grid; gap: 1.25rem; align-content: start; }
  .copy h2 { max-width: 12ch; }

  .card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--lime);
    color: var(--ink);
    border: 3px solid var(--paper);
    box-shadow: 8px 8px 0 var(--paper);
    text-decoration: none;
    transform: rotate(-1.5deg);
    transition: transform var(--med) var(--ease-snap), box-shadow var(--fast) var(--ease-snap);
  }
  .card:hover { transform: rotate(0deg) translate(3px, 3px); box-shadow: 5px 5px 0 var(--paper); }
  .tag { justify-self: start; padding: 0.25rem 0.5rem; background: var(--ink); color: var(--lime); }
  .name { font-size: clamp(2.6rem, 1.4rem + 5vw, 5.5rem); line-height: 0.85; }
  .what { font-size: var(--step-1); font-weight: 500; line-height: 1.3; }
  .go { justify-self: start; margin-top: 0.5rem; border-bottom: 3px solid var(--ink); }

  @media (min-width: 1000px) {
    .inner { grid-template-columns: 1.2fr 1fr; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .card:hover { transform: rotate(-1.5deg); }
  }
</style>
