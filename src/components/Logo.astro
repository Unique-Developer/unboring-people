---
/**
 * The UNBORING PEOPLE logo, from /public/brand (generated from "Brand Design Reference/Logo").
 * In boring mode the artwork is swapped for plain text, because a boring agency would never have this logo.
 */
interface Props {
  /** Which ground it sits on. */
  on?: 'light' | 'dark';
  layout?: 'stacked' | 'horizontal';
  class?: string;
  /** Loading hint; the header logo is eager, everything below the fold is lazy. */
  loading?: 'eager' | 'lazy';
}
const { on = 'light', layout = 'stacked', class: className, loading = 'eager' } = Astro.props;
const src = `/brand/logo-${layout}-on-${on}.svg`;
// Intrinsic ratios of the trimmed artwork, so the image reserves its space before it loads (no layout shift).
const size = layout === 'stacked' ? { width: 5616, height: 1912 } : { width: 9932, height: 1164 };
---

<span class:list={['logo', `logo--${layout}`, className]}>
  <img src={src} alt="UNBORING PEOPLE" width={size.width} height={size.height} loading={loading} decoding="async" />
  <span class="boring-text" aria-hidden="true">Unboring People</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; line-height: 1; }
  img { display: block; height: 100%; width: auto; max-width: 100%; }
  .boring-text { display: none; }

  :global(.boring-mode) .logo img { display: none; }
  :global(.boring-mode) .logo .boring-text {
    display: inline;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 1.15rem;
    color: #2f6fde;
  }
</style>
