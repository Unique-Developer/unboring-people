---
/** The client in founding seat 1, from site.config.ts. Who they are and what they make; no invented results. */
import { site } from '../site.config';

interface Props {
  /** Section label, e.g. "[07] Founding client". */
  label?: string;
  compact?: boolean;
}
const { label = 'Founding client', compact = false } = Astro.props;
const c = site.client;
const insta = `https://instagram.com/${c.instagram}`;
const { totalSeats, taken } = site.founding;
const left = totalSeats - taken.length;
---

<section class:list={['bz', 'on-ink', { compact }]} aria-labelledby="bz-title">
  <div class="wrap inner">
    <div class="copy">
      <p class="label lime">{label}</p>
      <h2 id="bz-title" class="display display-l" data-boring="Our Valued Clients">Seat 1 is taken.</h2>
      <p class="lede">
        {c.name} makes {c.what.toLowerCase()} for {c.forWho}, from {c.where}. They're our first founding client.{' '}
        {left === 0 ? 'All seats are taken.' : `${left} ${left === 1 ? 'seat' : 'seats'} left.`}
      </p>
      {!compact && left > 0 && (
        <a class="label more" href="/founding" data-cursor="sit">Take seat {taken.length + 1} <span aria-hidden="true">→</span></a>
      )}
    </div>

    <a class="card" href={insta} rel="noopener" data-cursor="look">
      <span class="label tag">Founding client</span>
      <span class="display name">{c.name}</span>
      <span class="what">{c.what}.</span>
      <span class="label meta">{c.where}</span>
      <span class="label go">@{c.instagram} on Instagram <span aria-hidden="true">→</span></span>
    </a>
  </div>
</section>

<style>
  .bz { border-bottom: var(--rule); }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-block: var(--section);
  }
  .compact .inner { padding-block: clamp(3rem, 6vw, 5rem); }
  .lime { color: var(--lime); }
  .copy { display: grid; gap: 1.25rem; align-content: start; }
  .copy h2 { max-width: 12ch; }
  .more {
    justify-self: start;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }
  .more:hover { color: var(--lime); }

  .card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--lime);
    color: var(--ink);
    border: 3px solid var(--paper);
    box-shadow: 8px 8px 0 var(--paper);
    text-decoration: none;
    transform: rotate(-1.5deg);
    transition: transform var(--med) var(--ease-snap), box-shadow var(--fast) var(--ease-snap);
  }
  .card:hover { transform: rotate(0deg) translate(3px, 3px); box-shadow: 5px 5px 0 var(--paper); }
  .tag { justify-self: start; padding: 0.25rem 0.5rem; background: var(--ink); color: var(--lime); }
  .name { font-size: clamp(2.6rem, 1.4rem + 5vw, 5.5rem); line-height: 0.85; }
  .what { font-size: var(--step-1); font-weight: 500; line-height: 1.3; }
  .go { justify-self: start; margin-top: 0.5rem; border-bottom: 3px solid var(--ink); }

  @media (min-width: 1000px) {
    .inner { grid-template-columns: 1.2fr 1fr; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .card:hover { transform: rotate(-1.5deg); }
  }
</style>
