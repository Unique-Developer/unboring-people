---
/**
 * /work: SWITCHED OFF. The leading underscore keeps Astro from building this route.
 * To turn it on once there's a real, client-approved case study in src/content/work:
 *   1. Rename this file to work.astro.
 *   2. Add { href: '/work', label: 'Work', verb: 'look' } to `nav` in site.config.ts.
 *   3. Remove `work` from the sitemap filter in astro.config.mjs.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import WorkCard from '../components/WorkCard.astro';

const studies = (await getCollection('work')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<Base title="Work: real results for real brands" description="Case studies from UNBORING PEOPLE's founding clients. Real numbers, approved by the clients themselves.">
  <PageHeader eyebrow="Work" title="Real work. Real numbers." boring="Our Portfolio">
    <p>Every number here is real and approved by the client. No mock-ups dressed up as results.</p>
  </PageHeader>
  <section class="wrap list">
    {studies.map((s) => <WorkCard study={s} />)}
  </section>
</Base>

<style>
  .list { display: grid; gap: 2.5rem; padding-block: var(--section); }
</style>
